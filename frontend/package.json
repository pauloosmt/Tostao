{
  "name": "tostao-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-guardrails.mjs",
    "preview": "vite preview",
    "test:guardrails": "node --test scripts/check-guardrails.test.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test:guardrails && npm test && npm run build && npm run check:budget && npm run test:build",
    "check:budget": "node scripts/check-budget.mjs",
    "test:build": "node --test scripts/check-build.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/league-spartan": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.4"
    }
  }
}
