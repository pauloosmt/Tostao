# Copie para .env (ignorado pelo git) e ajuste. Os padrões abaixo servem só para o ambiente local.

# Senha do dono do schema (usado pelo Flyway e pelo container do Postgres)
DB_MIGRATION_PASSWORD=tostao_dev
# Senha da role de aplicação tostao_app (sem BYPASSRLS), criada pela migration V2
DB_APP_PASSWORD=tostao_app_dev

# Assinatura do JWT: mínimo de 32 bytes. Em produção, gere um valor aleatório novo.
JWT_SECRET=dev-only-secret-change-me-dev-only-0123456789
# true em produção (HTTPS). false só no ambiente local.
COOKIE_SECURE=false
# Única origem permitida no CORS
CORS_ORIGIN=http://localhost:5173
